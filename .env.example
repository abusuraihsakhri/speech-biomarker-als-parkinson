# Speech Biomarker Als Parkinson - Environment Configuration
# Copy this file to .env and configure as needed

# HMAC-SHA256 Audit Trail Secret Key
# IMPORTANT: Generate a secure random key for production use:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If not set, a random key will be generated at startup (not persisted).
AUDIT_SECRET_KEY=

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000

# LLM Provider (mock, ollama, claude, openai)
LLM_PROVIDER=mock
