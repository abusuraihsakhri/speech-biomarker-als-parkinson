{
  "openapi": "3.1.0",
  "info": {
    "title": "Speech Biomarker Als Parkinson API",
    "description": "Experimental numeric-rule API. Does not process audio or infer diagnoses.",
    "version": "3.0.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus operational metrics",
        "responses": {
          "200": {
            "description": "JSON with process-local counters and status; not Prometheus text"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Apply rule-based thresholds to manually supplied numeric fields",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Respond via deterministic mock adapter (no external model)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Read in-memory audit entries (requires X-Audit-Token and server configuration)",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        },
        "parameters": [
          {
            "name": "X-Audit-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Equals configured AUDIT_LOG_READ_TOKEN. Endpoint disabled by default."
          }
        ]
      }
    }
  }
}
